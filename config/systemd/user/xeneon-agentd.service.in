[Unit]
Description=XENEON EDGE agent adapter
Documentation=https://github.com/spencerbull/xeneon-edge-agents
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment="XDG_CONFIG_HOME=@CONFIG_HOME@"
Environment="XDG_DATA_HOME=@DATA_HOME@"
Environment="XDG_STATE_HOME=@STATE_HOME@"
Environment="PATH=@BIN_HOME@:/usr/local/bin:/usr/bin"
EnvironmentFile=%t/xeneon-edge-agents/screen.env
ExecStartPre="@BIN_HOME@/xeneon-agentd" --config "@CONFIG_HOME@/xeneon-edge-agents/config.toml" --cleanup-dictation
ExecStart="@BIN_HOME@/xeneon-agentd" --config "@CONFIG_HOME@/xeneon-edge-agents/config.toml"
ExecStopPost=-"@BIN_HOME@/xeneon-agentd" --config "@CONFIG_HOME@/xeneon-edge-agents/config.toml" --cleanup-dictation
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@CONFIG_HOME@" "@DATA_HOME@" "@STATE_HOME@" %h/.cache -%h/Pictures -%h/Videos %t/xeneon-edge-agents
